+// QSA reduces four indexer heads for millions of rows during prefill. Give
+// each thread a whole row instead of launching one 32-thread block per row.
+static __global__ void sum_rows_f32_four(const float4 * x, float * dst, int64_t nrows) {
+    ggml_cuda_pdl_sync();
+    for (int64_t row = int64_t(blockIdx.x)*blockDim.x + threadIdx.x;
+         row < nrows; row += int64_t(gridDim.x)*blockDim.x) {
+        const float4 v = x[row];
+        // Same pairwise order as the original warp reduction for four values.
+        dst[row] = (v.x + v.z) + (v.y + v.w);
+    }
+}
+
+static bool sum_rows_four_cuda(const float * x, float * dst, int64_t ncols, int64_t nrows, cudaStream_t stream) {
+    static const bool enabled = [] {
+        const char * value = getenv("GGML_CUDA_SUM_ROWS_FOUR");
+        return value == nullptr || atoi(value) != 0;
+    }();
+    if (!enabled || ncols != 4 || nrows < 256 || (uintptr_t) x % alignof(float4) != 0) {
+        return false;
+    }
+    const dim3 blocks(MIN((nrows + 255)/256, UINT16_MAX), 1, 1);
+    const ggml_cuda_kernel_launch_params params = {blocks, dim3(256, 1, 1), 0, stream};
+    ggml_cuda_kernel_launch(sum_rows_f32_four, params, (const float4 *) x, dst, nrows);
+    return true;
+}
